{
    "name": "ezdistro",
    "version": "1.0.0",
    "description": "EzDistro Platform - self-hosted SEO content automation (WordPress indexer + AI writer)",
    "main": "index.js",
    "scripts": {
        "css:build": "npx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/app.css --minify",
        "css:watch": "npx @tailwindcss/cli -i ./app/static/css/input.css -o ./app/static/app.css --watch"
    },
    "keywords": ["seo", "content-automation", "wordpress", "fastapi", "htmx", "self-hosted"],
    "author": "Rastin Amani",
    "license": "Apache-2.0",
    "type": "commonjs",
    "devDependencies": {
        "@tailwindcss/cli": "^4.3.3",
        "prettier": "^3.8.3",
        "prettier-plugin-jinja-template": "^2.2.0",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "alpinejs": "^3.15.12",
        "daisyui": "^5.7.16",
        "htmx.org": "^2.0.10",
        "sortablejs": "^1.15.7",
        "swagger-ui-dist": "^5.32.6"
    }
}
