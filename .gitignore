# -----------------------------
# Python / FastAPI
# -----------------------------
venv/
.venv/
env/

.rooignore

__pycache__/
*.py[cod]
*$py.class

build/
dist/
*.egg-info/

.env
.env.*
!.env.example

# --- Secrets: never commit ---
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks

# --- Local data (PocketBase / Qdrant / scratch DBs) ---
pb_data/
qdrant_storage/
*.db
*.sqlite
*.sqlite3

# --- Private business docs (pricing, strategy, PRDs) — keep local, never push ---
private/
docs/private/

.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.dmypy.json

# Usually keep __init__.py tracked.
# If you REALLY want to ignore all __init__.py, uncomment this:
# **/__init__.py


# -----------------------------
# Node / Vite
# -----------------------------
node_modules/
dist/
dist-ssr/
*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# -----------------------------
# Logs
# -----------------------------
# Root-anchored: a bare `logs/` also swallowed app/templates/pages/logs/
# (the Events feed template), which then never entered the repository.
/logs/
*.log


# -----------------------------
# Editor / IDE
# -----------------------------
.vscode/*
!.vscode/extensions.json
.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# -----------------------------
# OS files
# -----------------------------
.DS_Store
Thumbs.db
.prettierrc


# docs/ is intentionally tracked (documentation set + the Dockerfile copies it
# into the image). Do not re-add "docs/" here.

# Uploads
app/static/uploads/

# OpenChamber local project state (screenshots, per-project actions)
.openchamber/

# Local distribution/marketing campaign output (regenerated, not product code)
distribution/
# Tool scratch (design briefs, screenshots) — local only
.impeccable/
