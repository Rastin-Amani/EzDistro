# =================== EzDistro Platform ===================
# Copy to .env and adjust.
#
# NOTE: keep values on the same line as the key with no trailing
# whitespace/comment after an empty value — pydantic-settings captures
# everything after "=" as the value.

# --- app ---
# dev | production
ENV=dev
APP_VERSION=0.1.0
# 32-byte urlsafe base64 Fernet key (REQUIRED in production; dev derives a stable key).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=

# --- PocketBase ---
PB_URL=https://db.ezdistro.rastin.cloud
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=admin@ezdistro.local
# optional: bootstrap creates this platform user
SEED_ADMIN_PASSWORD=

# --- Qdrant default (per-project credential overrides) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# --- SSRF guard ---
# 1 only for local development
ALLOW_PRIVATE_NETWORKS=0

# --- Worker process (python -m app.workers.worker) ---
# auto-generated when empty
WORKER_ID=
POLL_INTERVAL_SECONDS=5
LEASE_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=15
MAX_CONCURRENT_JOBS=4
SCHEDULE_POLL_INTERVAL_SECONDS=60

# --- LLM providers ---
# 1 = show Ollama (/v1) as a selectable LLM provider
OLLAMA_ENABLED=0

# --- Bounded provider concurrency (rate limits per worker) ---
LLM_CONCURRENCY=4
EMBEDDING_CONCURRENCY=4
PUBLISH_CONCURRENCY=2

# --- Observability ---
# 1 = record every provider call as a job_event
PROVIDER_EVENTS_ENABLED=0
