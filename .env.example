# =================== EzDistro Platform ===================
# Copy to .env and adjust. Only the six values below are needed for production —
# everything else has a working default in app/config.py (see the end of file).
#
# NOTE: never put a comment after a value — pydantic-settings captures
# everything after "=" as the value. Full-line "#" comments are safe.
#
# In Docker (Dokploy) there is no .env inside the image: set these in the
# container environment (Dokploy > Environment).

ENV=production

# 44-char urlsafe base64 Fernet key (encrypts integration credentials at rest).
# Generate, inside the container or locally:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back it up somewhere outside Docker — losing it makes every stored provider
# credential undecryptable and forces re-entering every integration API key.
# Setting a real key is a ROTATION: existing secretsEnc values must be re-entered once.
SECRETS_KEY=

PB_URL=https://db.ezdistro.space
# A PocketBase superuser. Create a dedicated account for the app
# (Dashboard > Collections > _superusers) instead of your own dashboard login.
# Load-bearing: without these the worker does not start and data routes fail.
PB_ADMIN_EMAIL=app@ezdistro.local
PB_ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# Worker pool — sized for 1 user, 20 projects, ~40 articles/day on a shared
# 1-core box. Peak parallel LLM calls = WORKERS x LLM_CONCURRENCY.
# --------------------------------------------------------------------------
WORKERS=2
MAX_CONCURRENT_JOBS=3
LLM_CONCURRENCY=4
EMBEDDING_CONCURRENCY=2
PUBLISH_CONCURRENCY=1
POLL_INTERVAL_SECONDS=5
LEASE_SECONDS=300
HEARTBEAT_INTERVAL_SECONDS=15
SCHEDULE_POLL_INTERVAL_SECONDS=60

# --------------------------------------------------------------------------
# Add only when needed. Defaults are in app/config.py and are correct for a
# small production deployment; uncomment to override.
# --------------------------------------------------------------------------

# Qdrant is only a fallback — projects with a `vector_store` integration use
# that instead. Without an integration and without this, indexing falls back
# to http://127.0.0.1:6333 and fails:
#QDRANT_URL=https://q.rastin.cloud:443
#QDRANT_API_KEY=

# Bootstrap-only (creates the first platform user); unused at runtime:
#SEED_ADMIN_EMAIL=admin@ezdistro.local
#SEED_ADMIN_PASSWORD=

# Rarely useful in production:
#WORKER_ID=
#ALLOW_PRIVATE_NETWORKS=0
#OLLAMA_ENABLED=0
#PROVIDER_EVENTS_ENABLED=0
#APP_VERSION=0.2.0

# For local development use ENV=dev (derives a secret key, serves /docs).
# Do not set PAGE_SIZE or SCHEDULE_WINDOW_MINUTES — they have no readers.
